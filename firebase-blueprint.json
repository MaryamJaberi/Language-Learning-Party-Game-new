{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with game preferences and sync data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "totalGamesPlayed": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["uid"]
    },
    "GameMatch": {
      "title": "GameMatch",
      "description": "Recorded match result and statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "winnerNames": { "type": "array", "items": { "type": "string" } },
        "winnerColor": { "type": "string" },
        "players": { "type": "array", "items": { "type": "string" } },
        "roundsCount": { "type": "number" },
        "difficulty": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "winnerNames", "winnerColor", "players"]
    },
    "OnlineRoom": {
      "title": "OnlineRoom",
      "description": "Live synchronized multiplayer game room for remote play",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "status": { "type": "string", "enum": ["lobby", "playing", "round_ended", "game_over"] },
        "currentRound": { "type": "number" },
        "activePlayerIndex": { "type": "number" },
        "settings": { "type": "object" },
        "teams": { "type": "array" },
        "players": { "type": "array" },
        "currentCard": { "type": "object" },
        "roundTimer": { "type": "number" },
        "isTimerRunning": { "type": "boolean" },
        "playedCards": { "type": "array" },
        "voiceProvider": { "type": "string" },
        "voiceLink": { "type": "string" },
        "reactions": { "type": "array" },
        "isPublic": { "type": "boolean" },
        "isMatchmaking": { "type": "boolean" },
        "isAiChallenger": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "hostId", "status"]
    },
    "MatchmakingTicket": {
      "title": "MatchmakingTicket",
      "description": "Active queue ticket for finding online matches",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "mode": { "type": "string", "enum": ["duel", "party"] },
        "targetLanguage": { "type": "string" },
        "cefrLevel": { "type": "string" },
        "roomId": { "type": "string" },
        "status": { "type": "string", "enum": ["searching", "matched", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "playerId", "mode", "status"]
    },
    "LeaderboardRecord": {
      "title": "LeaderboardRecord",
      "description": "High score entries on the global and local leaderboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playerName": { "type": "string" },
        "score": { "type": "number" },
        "accuracy": { "type": "number" },
        "totalCards": { "type": "number" },
        "targetLanguage": { "type": "string" },
        "cefrLevel": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "playerName", "score", "accuracy"]
    },
    "WeakCard": {
      "title": "WeakCard",
      "description": "Cards the user struggled with for spaced repetition and review",
      "type": "object",
      "properties": {
        "cardId": { "type": "string" },
        "targetText": { "type": "string" },
        "targetLanguage": { "type": "string" },
        "translation": { "type": "string" },
        "mistakeCount": { "type": "number" },
        "lastPracticed": { "type": "string" }
      },
      "required": ["cardId", "targetText"]
    },
    "Meetup": {
      "title": "Meetup",
      "description": "Public in-person language party meetup at a public venue (cafe, library, park, boardgame cafe, community center)",
      "type": "object",
      "properties": {
        "venueName": { "type": "string", "maxLength": 120 },
        "venueType": { "type": "string", "enum": ["cafe", "library", "park", "boardgame_cafe", "community_center"] },
        "city": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 120 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "placeId": { "type": "string", "maxLength": 200 },
        "targetLanguage": { "type": "string", "maxLength": 12 },
        "cefrLevel": { "type": "string", "enum": ["Pre-A1", "A0", "A0+", "A1", "A1+", "A2", "A2+", "B1", "B1+", "B2", "B2+", "C1", "C1+", "C2", "all"] },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 16 },
        "capacity": { "type": "number" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantNames": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "creatorUid": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "venueName",
        "venueType",
        "city",
        "area",
        "targetLanguage",
        "cefrLevel",
        "date",
        "time",
        "capacity",
        "participants",
        "participantNames",
        "notes",
        "creatorUid",
        "creatorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "MeetupReport": {
      "title": "MeetupReport",
      "description": "User safety or privacy report on a meetup listing",
      "type": "object",
      "properties": {
        "meetupId": { "type": "string", "maxLength": 128 },
        "reporterUid": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "enum": ["private_address", "unsafe", "spam", "inappropriate", "other"] },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["meetupId", "reporterUid", "reason", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing settings and profile"
    },
    "/users/{userId}/matches/{matchId}": {
      "schema": "GameMatch",
      "description": "Match history records owned by the user"
    },
    "/users/{userId}/weak_cards/{cardId}": {
      "schema": "WeakCard",
      "description": "User specific weak cards for spaced repetition"
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardRecord",
      "description": "Global leaderboard rankings"
    },
    "/rooms/{roomId}": {
      "schema": "OnlineRoom",
      "description": "Public remote multiplayer game room document"
    },
    "/matchmaking/{ticketId}": {
      "schema": "MatchmakingTicket",
      "description": "Active queue ticket for matchmaking"
    },
    "/meetups/{meetupId}": {
      "schema": "Meetup",
      "description": "Public in-person language party meetups at public venues"
    },
    "/meetup_reports/{reportId}": {
      "schema": "MeetupReport",
      "description": "Safety and privacy reports submitted against meetups"
    }
  }
}
